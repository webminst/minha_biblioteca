# Arquivo de exemplo para configuração do backend
# Copie este arquivo para backend/.env e preencha com suas credenciais

# Configuração do Servidor
PORT=3002

# Configuração do Banco de Dados
# Para desenvolvimento local:
# MONGODB_URI=mongodb://localhost:27017/pastor-portfolio

# Para MongoDB Atlas (produção):
# MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@cluster.mongodb.net/pastor-portfolio?retryWrites=true&w=majority&appName=Cluster0

# Segurança JWT - GERE UMA CHAVE FORTE!
# Use um gerador online ou comando: node utils/jwtSecurityUtils.js
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_64_CARACTERES_OU_MAIS

# Configurações de Expiração de Tokens (opcional)
JWT_ACCESS_EXPIRY=15m       # Access tokens expiram em 15 minutos
JWT_REFRESH_EXPIRY=7d       # Refresh tokens expiram em 7 dias
JWT_PARTIAL_EXPIRY=5m       # Tokens parciais (2FA) expiram em 5 minutos

# ========== CONFIGURAÇÃO 2FA ==========
ENABLE_2FA=true             # Habilita funcionalidade 2FA
TOTP_ISSUER=Pastor-Portfolio # Nome do emissor nos apps authenticator
TOTP_WINDOW=1               # Janela de tolerância (30s por unidade)
BACKUP_CODES_COUNT=10       # Quantidade de códigos de backup

# Configurações JWT Adicionais (opcional)
JWT_ISSUER=pastor-portfolio-api
JWT_AUDIENCE=pastor-portfolio-client

# Ambiente
NODE_ENV=development

CORS_ORIGIN=https://seusite.com
