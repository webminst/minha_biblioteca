# Arquivo de exemplo para configuração local
# Copie este arquivo para .env.local e preencha com suas credenciais

# Configuração da API para o frontend
REACT_APP_API_URL=http://localhost:3001

# Configuração de Informações de Suporte
REACT_APP_PIX_KEY=sua_chave_pix_aqui
REACT_APP_BANK_NAME=Nome_do_Banco
REACT_APP_ACCOUNT_HOLDER=Nome_do_Titular
